<section class="main-content">
    <div class="page-header">
        <h1>Explorer les albums</h1>
    </div>

    <div class="filter-section">
        <div class="filter-tags js-filter-tags">
            <label class="filter-radio">
                <input type="radio" name="tag-filter" value="all" checked>
                <span>Tous</span>
            </label>
            <?php foreach ($allTags as $tag): ?>
            <label class="filter-radio">
                <input type="radio" name="tag-filter" value="<?= $tag->getId() ?>">
                <span><?= htmlspecialchars($tag->getName()) ?></span>
            </label>
            <?php endforeach; ?>
        </div>
    </div>

    <?php if (empty($albums)): ?>
    <div class="empty-state">
        <h2>Aucun album public</h2>
        <p>Il n'y a pas encore d'albums publics partagés par les utilisateurs.</p>
    </div>
    <?php else: ?>
    <div class="albums-grid js-albums-grid">
        <?php foreach ($albums as $album): ?>
        <a href="<?= BASE_URL ?>/albums/show?id=<?= $album->getId() ?>" class="album-link js-album-card"
            data-tags="<?= implode(',', array_map(fn($t) => $t->getId(), $album->getTags())) ?>">
            <div class="card">
                <article class="card-body">
                    <header>
                        <h2 class="card-title"><?= htmlspecialchars($album->getTitle()) ?></h2>
                    </header>

                    <p class="card-meta">
                        <i class="fa-regular fa-user" aria-hidden="true"></i>
                        <?= htmlspecialchars($album->getUsername() ?? 'Utilisateur') ?>
                    </p>

                    <p class="card-meta">
                        <i class="fa-regular fa-calendar"></i> <?= $album->getFormattedDate() ?>
                    </p>

                    <footer class="card-footer-info">
                        <span class="badge badge-public">
                            <i class="fa-solid fa-earth-europe" aria-hidden="true"></i> Public
                        </span>

                        <ul class="album-tags-list">
                            <?php foreach ($album->getTags() as $tag): ?>
                            <li>
                                <span class="badge-tag">
                                    <i class="fa-solid fa-tag"></i><?= htmlspecialchars($tag->getName()) ?>
                                </span>
                            </li>
                            <?php endforeach; ?>
                        </ul>
                    </footer>
                </article>
            </div>
        </a>
        <?php endforeach; ?>
    </div>
    <?php endif; ?>
</section>