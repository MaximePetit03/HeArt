<section class="main-content">
    <div class="page-header">
        <h1>Mes Albums</h1>
    </div>

    <?php if (empty($albums)): ?>
    <div class="empty-state">
        <h2>Aucun album créé</h2>
        <p>Commencez à organiser vos photos en créant votre premier album.</p>
        <a href="<?= BASE_URL ?>/albums/create" class="btn btn-primary">
            <i class="fa-solid fa-plus"></i> Créer un album
        </a>
    </div>
    <?php else: ?>
    <div class="albums-grid">
        <?php foreach ($albums as $album): ?>
        <?php 
        // Vérifie si l'utilisateur actuel est le propriétaire
        $isOwner = ($album->getUserId() === (int)$_SESSION['user_id']);
        ?>

        <div>
            <?php if ($isOwner): ?>
            <form action="<?= BASE_URL ?>/albums/delete" method="POST"
                onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet album ?');" class="delete-album-form">
                <input type="hidden" name="album_id" value="<?= (int)$album->getId() ?>">
                <button type="submit" class="btn-delete-small" title="Supprimer l'album">
                    <i class="fa-solid fa-trash"></i>
                </button>
            </form>
            <?php endif; ?>

            <a href="<?= BASE_URL ?>/<?= $isOwner ? 'albums/edit' : 'albums/show' ?>?id=<?= $album->getId() ?>"
                class="card">
                <div class="card-body">
                    <h2 class="card-title"><?= htmlspecialchars($album->getTitle()) ?></h2>

                    <?php if (!$isOwner): ?>
                    <span class="badge badge-shared">
                        <i class="fa-solid fa-user-check"></i> Partagé avec moi
                    </span>
                    <?php endif; ?>

                    <div class="card-meta">
                        <i class="fa-regular fa-calendar"></i> <?= $album->getFormattedDate() ?>
                    </div>

                    <span class="badge js-visibility-badge badge-<?= $album->getVisibility() ?>">
                        <?= ucfirst($album->getVisibility()) ?>
                    </span>
                </div>
            </a>
        </div>
        <?php endforeach; ?>
    </div>
    <?php endif; ?>
</section>